invariant [invar_5] forall NODE3,NODE2,NODE1,NODE4,NODE0. ~q(NODE0) | ~r(NODE2) | p(NODE4) | p(NODE3) | ~q(NODE1) | ((NODE0 ~= NODE3 | NODE1 ~= NODE2 | NODE1 ~= NODE4 | NODE0 = NODE1) & (NODE0 ~= NODE4 | NODE1 ~= NODE2 | NODE1 = NODE3 | NODE0 = NODE3 | NODE0 = NODE1) & (NODE1 ~= NODE2 | NODE1 ~= NODE4 | NODE1 = NODE3 | NODE0 = NODE3 | NODE0 = NODE1) & (NODE0 ~= NODE3 | NODE1 ~= NODE4 | NODE1 = NODE2 | NODE0 = NODE2 | NODE0 = NODE1) & (NODE1 ~= NODE3 | NODE2 ~= NODE4 | NODE1 = NODE2 | NODE0 = NODE2 | NODE0 = NODE1) & (NODE1 ~= NODE2 | NODE0 = NODE4 | NODE3 = NODE4 | NODE0 = NODE3 | NODE1 = NODE4 | NODE1 = NODE3 | NODE0 = NODE1) & (NODE2 ~= NODE4 | NODE1 = NODE2 | NODE0 = NODE3 | NODE1 = NODE3 | NODE0 = NODE2 | NODE0 = NODE1 | NODE2 = NODE3) & (NODE0 ~= NODE4 | NODE1 = NODE2 | NODE0 = NODE3 | NODE1 = NODE3 | NODE0 = NODE2 | NODE0 = NODE1 | NODE2 = NODE3)) # qcost: 55
invariant [invar_6] forall NODE3,NODE2,NODE1,NODE4,NODE0. ~q(NODE0) | p(NODE4) | ~q(NODE2) | ~r(NODE3) | ~q(NODE1) | ((NODE0 ~= NODE4 | NODE2 ~= NODE3 | NODE1 = NODE2 | NODE0 = NODE2 | NODE0 = NODE1) & (NODE2 ~= NODE4 | NODE2 ~= NODE3 | NODE1 = NODE2 | NODE0 = NODE2 | NODE0 = NODE1) & (NODE2 ~= NODE3 | NODE1 = NODE2 | NODE0 = NODE4 | NODE1 = NODE4 | NODE0 = NODE2 | NODE0 = NODE1 | NODE2 = NODE4) & (NODE0 ~= NODE4 | NODE1 = NODE2 | NODE0 = NODE3 | NODE1 = NODE3 | NODE0 = NODE2 | NODE0 = NODE1 | NODE2 = NODE3) & (NODE3 ~= NODE4 | NODE1 = NODE2 | NODE0 = NODE3 | NODE1 = NODE3 | NODE0 = NODE2 | NODE0 = NODE1 | NODE2 = NODE3)) # qcost: 41
