#lang ivy1.8

type node = {node0, node1, node2, node3, node4}

relation p(X:node)
relation q(X:node)
relation r(X:node)

after init {
    p(X) := false;
    q(X) := false;
    r(X) := false;
}

action upq(x:node,y:node) = {
    require ~p(x) & ~q(y);
    p(x) := true;
    q(y) := true;
}

action upr(x:node,y:node) = {
    require ~p(x) & ~r(y);
    p(x) := true;
    r(y) := true;
}

action downq(x:node,y:node) = {
    require p(x) & q(y);
    p(x) := false;
    q(y) := false;
}

action downr(x:node,y:node) = {
    require p(x) & r(y);
    p(x) := false;
    r(y) := false;
}

#invariant p(X) -> exists Y. (q(Y) | r(Y))

export upq
export upr
export downq
export downr


invariant [invar_0] forall NODE1,NODE0,NODE4,NODE3,NODE2. p(NODE3) | p(NODE4) | ~r(NODE1) | ~q(NODE0) | ~r(NODE2) | ((NODE0 ~= NODE1 | NODE0 ~= NODE3 | NODE2 ~= NODE4 | NODE0 = NODE2) & (NODE0 ~= NODE1 | NODE2 ~= NODE4 | NODE0 = NODE3 | NODE0 = NODE2 | NODE2 = NODE3) & (NODE0 ~= NODE1 | NODE0 ~= NODE4 | NODE0 = NODE3 | NODE0 = NODE2 | NODE2 = NODE3) & (NODE0 ~= NODE3 | NODE2 ~= NODE4 | NODE0 = NODE2 | NODE0 = NODE1 | NODE1 = NODE2) & (NODE1 ~= NODE3 | NODE2 ~= NODE4 | NODE0 = NODE2 | NODE0 = NODE1 | NODE1 = NODE2) & (NODE0 ~= NODE2 | NODE1 = NODE3 | NODE0 = NODE1 | NODE1 = NODE4 | NODE0 = NODE3 | NODE3 = NODE4 | NODE0 = NODE4) & (NODE0 ~= NODE4 | NODE1 = NODE3 | NODE0 = NODE1 | NODE2 = NODE3 | NODE0 = NODE3 | NODE1 = NODE2 | NODE0 = NODE2) & (NODE1 ~= NODE4 | NODE1 = NODE3 | NODE0 = NODE1 | NODE2 = NODE3 | NODE0 = NODE3 | NODE1 = NODE2 | NODE0 = NODE2)) # qcost: 55
invariant [invar_1] forall NODE1,NODE0,NODE4,NODE3,NODE2. p(NODE3) | p(NODE4) | ~r(NODE1) | p(NODE2) | ~q(NODE0) | ((NODE0 ~= NODE3 | NODE1 ~= NODE4 | NODE0 = NODE2 | NODE0 = NODE1 | NODE1 = NODE2) & (NODE0 ~= NODE1 | NODE0 ~= NODE4 | NODE0 = NODE3 | NODE0 = NODE2 | NODE2 = NODE3) & (NODE0 ~= NODE1 | NODE2 = NODE4 | NODE2 = NODE3 | NODE0 = NODE3 | NODE3 = NODE4 | NODE0 = NODE4 | NODE0 = NODE2) & (NODE0 ~= NODE4 | NODE1 = NODE3 | NODE0 = NODE1 | NODE2 = NODE3 | NODE0 = NODE3 | NODE1 = NODE2 | NODE0 = NODE2) & (NODE1 ~= NODE4 | NODE1 = NODE3 | NODE0 = NODE1 | NODE2 = NODE3 | NODE0 = NODE3 | NODE1 = NODE2 | NODE0 = NODE2)) # qcost: 41
invariant [invar_2] forall NODE1,NODE2,NODE3,NODE0. p(NODE3) | ~r(NODE0) | ~r(NODE1) | p(NODE2) | p(NODE1) | ((NODE0 ~= NODE3 | NODE0 = NODE2 | NODE0 = NODE1 | NODE1 = NODE2) & (NODE1 = NODE3 | NODE0 = NODE1 | NODE2 = NODE3 | NODE0 = NODE3 | NODE1 = NODE2 | NODE0 = NODE2)) # qcost: 19
