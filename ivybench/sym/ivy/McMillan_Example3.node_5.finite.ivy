invariant [invar_6] forall NODE1,NODE0,NODE4,NODE3,NODE2. ~q(NODE2) | ~q(NODE1) | p(NODE4) | ~r(NODE3) | ~q(NODE0) | ((NODE0 ~= NODE4 | NODE2 ~= NODE3 | NODE0 = NODE2 | NODE0 = NODE1 | NODE1 = NODE2) & (NODE2 ~= NODE4 | NODE2 ~= NODE3 | NODE0 = NODE2 | NODE0 = NODE1 | NODE1 = NODE2) & (NODE2 ~= NODE3 | NODE1 = NODE4 | NODE0 = NODE1 | NODE2 = NODE4 | NODE0 = NODE4 | NODE1 = NODE2 | NODE0 = NODE2) & (NODE0 ~= NODE4 | NODE1 = NODE3 | NODE0 = NODE1 | NODE2 = NODE3 | NODE0 = NODE3 | NODE1 = NODE2 | NODE0 = NODE2) & (NODE3 ~= NODE4 | NODE1 = NODE3 | NODE0 = NODE1 | NODE2 = NODE3 | NODE0 = NODE3 | NODE1 = NODE2 | NODE0 = NODE2)) # qcost: 41
